{
  "name": "boston-amtrak-tracker",
  "version": "0.0.0",
  "description": "add on component to inky mbta tracker that keeps track of amtrak trains in new england ",
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/eslint__js": "9.14.0",
    "@types/koa": "3.0.3",
    "@types/koa__cors": "5.0.1",
    "@types/koa__router": "12.0.5",
    "@types/node": "24.13.3",
    "@typescript-eslint/parser": "8.70.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "rimraf": "6.1.3",
    "ts-api-utils": "2.5.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.1"
  },
  "scripts": {
    "startenv": "node --env-file=.env build/src/main.js",
    "start": "node build/src/main.js",
    "clean": "rimraf coverage build tmp",
    "prebuild": "pnpm run lint",
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -w -p tsconfig.json",
    "build:release": "pnpm run clean && tsc -p tsconfig.release.json",
    "lint": "eslint .",
    "test:coverage": "vitest run unit --config __tests__/vitest.config.ts --coverage.enabled --coverage.all",
    "prettier": "prettier \"{src,__{tests}__}/**/*.{ts,mts}\" --config .prettierrc --write",
    "prettier:check": "prettier \"{src,__{tests}__}/**/*.{ts,mts}\" --config .prettierrc --check",
    "types": "wget -O shared_types.py https://raw.githubusercontent.com/cubismod/inky-mbta-tracker/refs/heads/main/inky-mbta-tracker/shared_types/shared_types.py && uv run pydantic2ts --module ./shared_types.py --output src/sharedTypes.ts"
  },
  "author": "Ryan Wallace",
  "license": "Apache-2.0",
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.0.0",
    "@turf/turf": "^7.2.0",
    "amtrak": "^3.0.11",
    "json-schema-to-typescript": "^15.0.4",
    "koa": "^3.0.0",
    "koa-static": "^5.0.0",
    "koa2-swagger-ui": "^5.11.0",
    "loglevel": "^1.9.2",
    "tslib": "~2.8"
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45"
}
